{
  "id": "./",
  "name": "QA PLUS Blog Studio",
  "short_name": "QA+ Studio",
  "description": "QA PLUS 유튜브 대본을 식품안전·품질관리 Blogger 콘텐츠로 만드는 자동화 앱",
  "lang": "ko-KR",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f7f8",
  "theme_color": "#0b1f33",
  "categories": ["productivity", "business", "education"],
  "icons": [
    {
      "src": "./icons/qa-plus-icon.svg",
      "sizes": "any",
